 NeuralNet::BatchPolicy NeuralNet::getBatchPolicy(ConfigParser& cfg) {
-  (void)cfg;
-  return NeuralNet::BatchPolicy::Dynamic;
+  // MPSGraph compiles a new executable the first time it runs at each batch size, which takes
+  // seconds and stalls every search thread waiting on the GPU. So by default (metalPadBatch) the
+  // GPU path holds the batch size fixed and pads short batches, and the batch is sized the
+  // fixed-shape way (about half the concurrent evaluations) to keep the padding cheap. An
+  // nnMaxBatchSize set in the config is normally sized for dynamic batching (analysis_example.cfg
+  // asks for at least the total number of search threads), and padding every batch up to it would
+  // multiply the GPU work, so by default such a config keeps dynamic batches.
+  return metalPadsBatch(cfg) ? NeuralNet::BatchPolicy::FixedShape : NeuralNet::BatchPolicy::Dynamic;
 }
 
