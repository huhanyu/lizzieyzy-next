+// metalPadBatch: whether GPU (MPSGraph) batches run padded up to nnMaxBatchSize, see getBatchPolicy.
+static bool metalPadsBatch(ConfigParser& cfg) {
+  enabled_t padBatchMode = cfg.contains("metalPadBatch") ? cfg.getEnabled("metalPadBatch") : enabled_t::Auto;
+  if(padBatchMode == enabled_t::Auto)
+    return !cfg.contains("nnMaxBatchSize");
+  return padBatchMode == enabled_t::True;
